{
  "name": "zephyr-music",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . --ext .ts,.tsx,.vue,.js,.mjs,.cjs",
    "lint:fix": "eslint . --ext .ts,.tsx,.vue,.js,.mjs,.cjs --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,js,mjs,cjs,css,html,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,vue,js,mjs,cjs,css,html,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "clean": "node script/clean.js",
    "clean:dry": "node script/clean.js --dry",
    "stats": "node script/stats.js",
    "build:full": "node script/build.js",
    "build:check": "node script/build.js --check",
    "dev:check": "node script/dev.js --check",
    "package": "node script/package.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-store": "^2.4.3",
    "pinia": "^2.3.0",
    "three": "^0.185.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tauri-apps/cli": "^2.2.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}

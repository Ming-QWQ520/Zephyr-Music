{
  "name": "zephyr-music",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . --ext .ts,.tsx,.vue,.js,.mjs,.cjs",
    "lint:fix": "eslint . --ext .ts,.tsx,.vue,.js,.mjs,.cjs --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,js,mjs,cjs,css,html,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,vue,js,mjs,cjs,css,html,json,md}\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "pinia": "^2.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}

